{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": { "eq": "elroble.ar" } }],
      "destination": "https://www.elroble.ar/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public,max-age=31536000,immutable" }
      ]
    }
  ]
}
